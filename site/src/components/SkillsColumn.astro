---
interface Skill {
  text: string;
  lenses?: string[];
}

interface Props {
  title: string;
  skills: Skill[];
  activeLens?: string;
}

const { title, skills, activeLens = "" } = Astro.props;
---

<div class="skill-column">
  <h4>{title}</h4>
  <div class="skills-list">
    {skills.map((skill) => (
      <span
        class={`skill-tag ${
          activeLens && skill.lenses?.includes(activeLens) ? "highlighted" : ""
        }`}
        data-l={skill.lenses?.join(" ") || ""}
      >
        {skill.text}
      </span>
    ))}
  </div>
</div>

<style>
  .skill-column {
    padding: var(--space-6);
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: 4px;
  }

  .skill-column h4 {
    margin-bottom: var(--space-4);
  }

  .skills-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .skill-tag {
    display: block;
    padding: var(--space-3);
    background: var(--panel-2);
    border-left: 2px solid var(--rule);
    font-size: var(--fs-14);
    line-height: 1.5;
    color: var(--ink-2);
    transition: all 0.2s ease;
  }

  .skill-tag.highlighted {
    background: var(--sage-wash);
    border-left-color: var(--sage);
    color: var(--ink);
  }

  .skill-tag::before {
    display: inline-block;
    content: "●";
    color: var(--rule);
    margin-right: var(--space-2);
    font-size: var(--fs-11);
  }

  .skill-tag.highlighted::before {
    color: var(--sage);
  }
</style>
