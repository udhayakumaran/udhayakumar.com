---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';
---

<Layout title="Resume — Udhaya Kumar" description="Download the resume for Udhaya Kumar, Senior Backend Engineer and Data Platform Architect.">
  <section style="padding: 52px 0; border-bottom: 1px solid var(--rule);">
    <h1 style="font-family: 'JetBrains Mono', monospace; font-size: var(--fs-40); font-weight: 600; margin-bottom: 32px;">Resume</h1>
    <p style="font-size: 16px; line-height: 1.8; color: var(--ink); margin-bottom: 32px; max-width: 65ch;">Architect and operate high-scale data systems where every layer (ingestion, modeling, serving, operations) matters. Rearchitected data platform at ConvertCart from batch-sync (days-late latency) to real-time CDC (sub-minute latency) serving 200+ e-commerce merchants. Designed segmentation engine (1,000+ active segments, 80% merchant adoption) and built recommendation system from zero-to-one. Grew backend platform team from 4 to 7 engineers.</p>
    <p style="font-size: 14px; color: var(--ink-2); max-width: 65ch;">Seeking: Staff Engineer, Principal Engineer, or Founding Engineer roles in data infrastructure or platform systems. Remote-first.</p>
  </section>

  <!-- Download Resume -->
  <section style="padding: 52px 0; border-bottom: 1px solid var(--rule);">
    <a href="/resume.pdf" style="text-decoration: none; display: block; padding: 32px; background: var(--panel); border: 2px solid var(--accent); border-radius: 4px; transition: border-color 0.2s ease;">
      <p style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--accent); font-weight: 600; margin-bottom: 8px;">Download Resume · PDF</p>
      <p style="font-size: 20px; font-weight: 600; color: var(--ink); margin-bottom: 8px;">Senior Backend Engineer | Data Platform Architect</p>
      <p style="font-size: 16px; color: var(--ink-2);">Backend infrastructure, data platforms, distributed systems, and production operations.</p>
    </a>
  </section>

  <section style="padding: 28px 0 0;">
    <a href="/engineering-notes/incidents/" style="color: var(--accent); font-family: 'IBM Plex Mono', monospace; font-size: 14px;">Read the ten incident records behind this resume →</a>
  </section>
</Layout>
