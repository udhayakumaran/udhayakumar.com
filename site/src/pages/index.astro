---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTAButton from '../components/CTAButton.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import StatBar from '../components/StatBar.astro';
import StatCallout from '../components/StatCallout.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import ToolLogoGrid from '../components/ToolLogoGrid.astro';
import LensSelector from '../components/LensSelector.astro';
import ActivityWidget from '../components/ActivityWidget.astro';
import ProductCard from '../components/ProductCard.astro';
import SkillsColumn from '../components/SkillsColumn.astro';
import TimelineEntry from '../components/TimelineEntry.astro';
---

<Layout title="Udhayakumar — Staff Backend / Platform Engineer">
  <!-- Hero / Masthead -->
  <section style="padding: var(--space-section) 0 0;">
    <div style="font-family: 'IBM Plex Mono', monospace; font-size: var(--fs-12); color: var(--accent); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: var(--space-4);">
      Staff Backend / Platform Engineer
    </div>
    <h1 style="margin-bottom: var(--space-4);">
      I build and own backend systems that other products depend on.
    </h1>
    <p style="font-size: var(--fs-18); color: var(--ink-2); margin-bottom: var(--space-6); max-width: 65ch;">
      13 years backend systems · 5 years platform ownership
      Fully remote
    </p>


    <div style="display: flex; gap: var(--space-4); flex-wrap: wrap; margin-bottom: var(--space-8);">
      <CTAButton href="/resume" label="View résumé" variant="solid" />
      <CTAButton href="mailto:mail4udhaya@gmail.com" label="Get in touch" variant="outline" />
      <a href="https://linkedin.com/in/udhayakumar" target="_blank" rel="noopener" style="align-self: center; font-size: var(--fs-14); border-bottom: 1px solid transparent; transition: border-color 0.2s;">LinkedIn</a>
      <a href="https://github.com/udhayakumaran" target="_blank" rel="noopener" style="align-self: center; font-size: var(--fs-14); border-bottom: 1px solid transparent; transition: border-color 0.2s;">GitHub</a>
    </div>

    <div style="display: flex; gap: var(--space-6); margin-bottom: var(--space-section); flex-wrap: wrap; font-size: var(--fs-16);">
      <div>
        <div style="font-size: var(--fs-40); font-weight: 600; color: var(--accent); margin-bottom: var(--space-2);">200+</div>
        <div style="font-size: var(--fs-13); color: var(--ink-2);">stores</div>
      </div>
      <div>
        <div style="font-size: var(--fs-40); font-weight: 600; color: var(--accent); margin-bottom: var(--space-2);">sub-minute</div>
        <div style="font-size: var(--fs-13); color: var(--ink-2);">freshness</div>
      </div>
      <div>
        <div style="font-size: var(--fs-40); font-weight: 600; color: var(--accent); margin-bottom: var(--space-2);">200ms</div>
        <div style="font-size: var(--fs-13); color: var(--ink-2);">p99 latency</div>
      </div>
    </div>
  </section>

  <!-- Selected Systems Index -->
  <section style="padding: var(--space-section) 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule);">
    <div style="font-family: 'IBM Plex Mono', monospace; font-size: var(--fs-12); color: var(--accent); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: var(--space-8);">
      Selected Systems
    </div>

    <div style="display: grid; gap: var(--space-8); max-width: 65ch;">
      <div>
        <div style="font-size: var(--fs-14); font-weight: 600; color: var(--accent); margin-bottom: var(--space-2);">01 DATA PLATFORM</div>
        <p style="font-size: var(--fs-16); line-height: 1.6; color: var(--ink); margin: 0;">Rebuilt the platform serving 200+ merchants. Sub-minute freshness for webhooks, up to 6 hours for custom integrations.</p>
      </div>
      <div>
        <div style="font-size: var(--fs-14); font-weight: 600; color: var(--accent); margin-bottom: var(--space-2);">02 CUSTOMER SEGMENTATION</div>
        <p style="font-size: var(--fs-16); line-height: 1.6; color: var(--ink); margin: 0;">Infrastructure behind 1,000+ behavioural segments. Enabled non-technical staff to build audiences without filing tickets.</p>
      </div>
      <div>
        <div style="font-size: var(--fs-14); font-weight: 600; color: var(--accent); margin-bottom: var(--space-2);">03 RECOMMENDATIONS</div>
        <p style="font-size: var(--fs-16); line-height: 1.6; color: var(--ink); margin: 0;">Multi-region recommendation serving. 80%+ adoption on hardest tier; 200ms p99 latency across five regions.</p>
      </div>
      <div>
        <div style="font-size: var(--fs-14); font-weight: 600; color: var(--accent); margin-bottom: var(--space-2);">04 MICROSERVICES FLEET</div>
        <p style="font-size: var(--fs-16); line-height: 1.6; color: var(--ink); margin: 0;">57+ coordinated microservices. Built CI/CD automation and multi-service observability across the fleet.</p>
      </div>
    </div>
  </section>

  <!-- Specialties -->
  <section style="padding: var(--space-section) 0; border-bottom: 1px solid var(--rule);">
    <p style="font-size: var(--fs-16); color: var(--ink); margin: 0;">
      <strong>Specialties:</strong> Backend architecture · Data platforms · Distributed systems · Production migrations · Technical leadership
    </p>
  </section>

  <!-- Lens Selector -->
  <section style="padding: var(--space-section) 0; border-bottom: 1px solid var(--rule);">
    <LensSelector
      lenses={[
        {
          id: "data",
          label: "Data Platform",
          note: "Five years owning a data platform end to end — ingestion, modelling, serving, and the cost of running it. Two CDC paths, a warehouse consolidation, a multi-tenant landing store, and a reporting migration driven by the shape of a billing model.",
        },
        {
          id: "arch",
          label: "Architecture",
          note: "Every case study below states what I rejected and why. The through-line: refuse to normalise at the ingestion boundary where the decision is irreversible, then normalise in the warehouse where a wrong model is a redefinition rather than a migration.",
        },
        {
          id: "founding",
          label: "Founding Engineer",
          note: "Zero to one twice over — a recommendation product built from scratch inside a startup and taken to 80%+ adoption on its hardest tier, and six products designed, built and shipped alone outside one.",
        },
        {
          id: "ecom",
          label: "E-commerce",
          note: "Shopify, BigCommerce, WooCommerce, and Magento 1 and 2 — in production simultaneously for 200+ merchants. Webhook reliability, catalogue sync, storefront latency budgets, conversion attribution, and the constraint that a merchant absorbs zero cost.",
        },
      ]}
      defaultLens="data"
    />
  </section>

  <!-- By the numbers -->
  <section style="padding: var(--space-section) 0; border-bottom: 1px solid var(--rule);">
    <SectionEyebrow label="By the numbers" />
    <StatBar
      stats={[
        { value: "3 months", label: "Migration, zero rollbacks", pct: 100 },
        { value: "200+", label: "Stores on 5 platforms", pct: 100 },
        { value: "1,000+", label: "Active segments", pct: 100 },
        { value: "80%+", label: "Smart tier adoption", pct: 80 },
      ]}
    />
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: var(--space-6); margin-top: var(--space-8);">
      <StatCallout value="sub-minute" label="Data freshness" subtext="webhooks; up to 6h custom" />
      <StatCallout value="200ms" label="p99 latency" subtext="serving" />
      <StatCallout value="4-person" label="Team size" subtext="3-month migration" />
    </div>
  </section>

  <!-- Selected Work -->
  <section style="padding: var(--space-section) 0; border-bottom: 1px solid var(--rule);">
    <SectionEyebrow label="Selected work" />
    <div style="display: grid; gap: var(--space-6);">
      <CaseStudyCard
        href="/case-studies/data-platform"
        title="The data platform"
        subtitle="Rebuilt how customer and order data flows through the company — from data arriving days late to sub-minute freshness, across 200+ merchant stores on five e-commerce platforms. Migrated in 3 months with zero rollbacks, recovered from a production incident that nearly blocked the entire rollout."
        metrics={["days → sub-minute", "3-month migration", "200+ stores"]}
        variant="spotlight"
      />
      <CaseStudyCard
        href="/case-studies/segmentation"
        title="Customer segmentation"
        subtitle="Built the system that lets a non-technical Customer Success rep build audiences without writing a line of code or filing an engineering ticket. The hardest thing I built."
        metrics={["4 source systems", "1 query", "1,000+ segments"]}
        variant="spotlight"
      />
      <CaseStudyCard
        href="/case-studies/recommendations"
        title="Recommendation blocks"
        subtitle="Built the company's product recommendation feature from nothing, designed so store owners could trust it enough to turn it on. 80%+ adoption on the hardest tier."
        metrics={["80%+ adoption", "5 regions", "200ms p99"]}
        variant="spotlight"
      />
    </div>
  </section>

  <!-- Also Shipped -->
  <section style="padding: var(--space-section) 0; border-bottom: 1px solid var(--rule);">
    <SectionEyebrow label="Also shipped" />
    <div style="display: grid; gap: var(--space-6);">
      <div class="shipped-item reveal">
        <h4>Microservice fleet at ConvertCart</h4>
        <p>Recommendation ranking, email delivery, analytics ingestion, webhook distribution — split from the monolith into coordinated services. Owned deployment, configuration, and observability across the fleet. Built CI/CD automation and multi-service observability across 57+ microservices.</p>
      </div>
      <div class="shipped-item reveal">
        <h4>MySQL optimisation at Scientific Games</h4>
        <p>Lottery reporting queries running 45 minutes daily on an un-indexed 20M-row schema. Analysed and restructured queries, designed covering indexes, partitioned tables by date. Reduced the same workload from 45 minutes to 3.</p>
      </div>
      <div class="shipped-item reveal">
        <h4>Email infrastructure at Tenlegs</h4>
        <p>Built the data infrastructure supporting millions of emails/day — recommendation feeds and transactional data pipelines providing all data to the email delivery system. Worked with the email team to ensure data freshness and reliability for high-volume sending.</p>
      </div>
    </div>
  </section>

  <!-- Activity -->
  <section style="padding: var(--space-section) 0; border-bottom: 1px solid var(--rule);">
    <SectionEyebrow label="Activity" />
    <ActivityWidget />
  </section>

  <!-- Engineering Notes -->
  <section style="padding: var(--space-section) 0; border-bottom: 1px solid var(--rule);">
    <SectionEyebrow label="Engineering Notes" />
    <p style="font-size: var(--fs-16); color: var(--ink); margin-bottom: var(--space-6); max-width: 65ch;">Deep-dives into architecture decisions, incident recovery, and systems thinking from building data platforms at scale.</p>
    <a href="/engineering-notes" style="font-size: var(--fs-14); color: var(--accent); text-decoration: none; border-bottom: 1px solid transparent; transition: border-color 0.2s;">Read the notes →</a>
  </section>

  <!-- Outside Work -->
  <section style="padding: var(--space-section) 0; border-bottom: 1px solid var(--rule);">
    <SectionEyebrow label="Outside work" />
    <p style="font-size: var(--fs-16); color: var(--ink); margin-bottom: var(--space-6); max-width: 65ch;">I don't stop building when the workday ends. Here's what I've shipped.</p>

    <div style="margin-bottom: var(--space-8);">
      <h3 style="font-size: var(--fs-14); font-weight: 600; color: var(--accent); margin-bottom: var(--space-6);">Shipped</h3>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: var(--space-6);">
        <ProductCard
          name="Fruggy"
          description="Grocery shopping planner for Indian FMCG shoppers. Flutter app with a dataset of 1,500+ FMCG items."
          status="1,000+ downloads"
          image="/assets/fruggy.png"
        />
        <ProductCard
          name="HitReplAI"
          description="AI-powered social media reply generator that learns and mimics the user's writing style."
          status="Live on Chrome Web Store"
          image="/assets/hitreplai.png"
        />
        <ProductCard
          name="en-bus"
          description="Tamil Nadu bus routes and timings finder. Real-time route search across TNSTC, SETC, and MTC buses."
          status="Live · 93K+ trips"
          image="/assets/enbus.png"
        />
      </div>
    </div>

    <div>
      <h3 style="font-size: var(--fs-14); font-weight: 600; color: var(--accent); margin-bottom: var(--space-6);">Currently building</h3>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: var(--space-6);">
        <ProductCard
          name="affairsmap.com"
          description="Current-affairs study platform for UPSC, SSC, Banking, RBI Grade B and Defence exam aspirants."
          status="In development"
        />
      </div>
    </div>
  </section>

  <!-- Tech Stack -->
  <section style="padding: var(--space-section) 0; border-bottom: 1px solid var(--rule);">
    <SectionEyebrow label="Stack" />
    <ToolLogoGrid
      tools={[
        "Node.js",
        "TypeScript",
        "MySQL",
        "Debezium",
        "Pub/Sub",
        "MongoDB",
        "BigQuery",
        "ClickHouse",
        "Redis",
        "GKE",
      ]}
    />
  </section>

  <!-- Engineering Principles -->
  <section style="padding: var(--space-section) 0; border-bottom: 1px solid var(--rule);">
    <SectionEyebrow label="Principles" />
    <div style="display: grid; gap: var(--space-6);">
      <div class="principle reveal">
        <h4>Reversibility</h4>
        <p>Refuse to normalize at ingestion where the decision is irreversible. Normalize in the warehouse where a wrong model is a redefinition, not a migration.</p>
      </div>
      <div class="principle reveal">
        <h4>Match storage to question</h4>
        <p>No single database serves all workloads. Point lookups need one shape, aggregation needs another. Accept the operational cost of multiple shapes matched to their use.</p>
      </div>
      <div class="principle reveal">
        <h4>Operational simplicity</h4>
        <p>Abstractions cost clarity under pressure. Ship what's straightforward to operate and debug. Only abstract where the operational burden actually drives the design.</p>
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section style="padding: var(--space-section) 0; border-bottom: 1px solid var(--rule);">
    <SectionEyebrow label="Skills" />
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-6);">
      <SkillsColumn
        title="Deep"
        skills={[
          { text: "Data pipeline design — end-to-end ingestion, CDC, multi-layer serving", lenses: ["data", "arch"] },
          { text: "Streaming & CDC — Debezium fan-out to Pub/Sub", lenses: ["data", "arch"] },
          { text: "BigQuery & analytics — Datastream replication, materialized views", lenses: ["data"] },
          { text: "ClickHouse — schema design, partitioning, ORDER BY tuning", lenses: ["data"] },
          { text: "System design — microservices, distributed tracing, reliability", lenses: ["arch"] },
          { text: "E-commerce platforms — Shopify, BigCommerce, WooCommerce, Magento", lenses: ["ecom"] },
        ]}
      />
      <SkillsColumn
        title="Working knowledge"
        skills={[
          { text: "Kafka", lenses: ["data"] },
          { text: "Apache Beam", lenses: ["data"] },
          { text: "Kubernetes", lenses: ["arch"] },
          { text: "GCP infrastructure", lenses: ["arch"] },
          { text: "React", lenses: ["founding"] },
          { text: "React Native", lenses: ["founding"] },
          { text: "Redis", lenses: [] },
          { text: "PostgreSQL", lenses: [] },
        ]}
      />
      <SkillsColumn
        title="Leadership & Scale"
        skills={[
          { text: "Team growth — grew platform team from 4 to 7 engineers without losing coherence", lenses: [] },
          { text: "Architecture ownership — moved migration timing by 6–12 months and cost structure through architecture decisions", lenses: [] },
          { text: "Production incident response — 50M-row snapshot hit production; diagnosed, stopped, re-strategized, recovered", lenses: [] },
          { text: "Large-scale migrations — store-by-store cutover across 200+ merchants with zero rollback", lenses: [] },
          { text: "Cross-functional partnerships — moved product segmentation from engineering bottleneck to self-service", lenses: [] },
        ]}
      />
    </div>
  </section>

  <!-- Background -->
  <section style="padding: var(--space-section) 0; border-bottom: 1px solid var(--rule);">
    <SectionEyebrow label="Background" />
    <p style="font-size: var(--fs-16); line-height: 1.8; color: var(--ink); margin-bottom: var(--space-8); max-width: 65ch;">
      13 years building backend systems and data infrastructure. Started building for the web in 2010. Spent nearly six years at ConvertCart, five of them owning a data platform end to end and leading a team of engineers to rebuild it. Built segmentation and recommendation engines on top. Founded and shipped independent products. Experienced hiring and evaluating backend/data engineers; comfortable in both IC and multiplier roles.
    </p>
    <div style="display: grid; gap: 0;">
      <TimelineEntry index="A1" years="2020–2026" company="ConvertCart" role="Backend Engineer, Platform Ownership — Data ingestion, warehouse consolidation, multi-channel personalisation" />
      <TimelineEntry index="A2" years="2018–2019" company="Friday Media Group" role="Backend Engineer, Founding Team — Marketplace APIs, content ingestion, data pipeline" />
      <TimelineEntry index="A3" years="2014–2018" company="Scientific Games" role="Backend Engineer — Lottery reporting, data optimization, microservices" />
      <TimelineEntry index="A4" years="2012–2014" company="Tenlegs" role="Full-stack Engineer — Email systems, logistics APIs, operational tools" />
      <TimelineEntry index="A5" years="2010–2012" company="ISPG Technologies" role="Junior Developer — E-commerce backend, MySQL optimization" />
    </div>
  </section>

  <!-- CTA -->
  <section style="padding: var(--space-section) 0;">
    <div style="border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding: var(--space-8) 0;">
      <h2 style="font-size: var(--fs-32); margin-bottom: var(--space-6);">
        Have a backend problem that needs an owner?
      </h2>
      <p style="font-size: var(--fs-16); color: var(--ink-2); margin-bottom: var(--space-6); max-width: 65ch;">I'm currently talking to founders and engineering leaders about Staff/Lead backend and platform roles. Fully remote, $60k+ salary floor.</p>
      <div style="display: flex; gap: var(--space-4); flex-wrap: wrap;">
        <CTAButton href="mailto:mail4udhaya@gmail.com" label="Email me" variant="solid" />
        <CTAButton href="/resume" label="View résumé" variant="outline" />
        <a href="https://linkedin.com/in/udhayakumark" target="_blank" rel="noopener" style="align-self: center; font-size: var(--fs-16); color: var(--ink); border-bottom: 1px solid transparent; transition: border-color 0.2s;">LinkedIn</a>
        <a href="https://github.com/udhayakumaran" target="_blank" rel="noopener" style="align-self: center; font-size: var(--fs-16); color: var(--ink); border-bottom: 1px solid transparent; transition: border-color 0.2s;">GitHub</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .shipped-item {
    padding: var(--space-6);
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: 4px;
  }

  .shipped-item h4 {
    margin-bottom: var(--space-2);
  }

  .shipped-item p {
    font-size: var(--fs-14);
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0;
  }

  .principle {
    padding: var(--space-6);
    background: var(--sage-wash);
    border-left: 3px solid var(--sage);
    border-radius: 4px;
  }

  .principle h4 {
    margin-bottom: var(--space-2);
  }

  .principle p {
    font-size: var(--fs-14);
    line-height: 1.6;
    color: var(--ink);
    margin: 0;
  }

  .faq-item {
    padding: var(--space-4);
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: 4px;
    cursor: pointer;
  }

  .faq-item summary {
    font-family: "IBM Plex Mono", monospace;
    font-weight: 600;
    font-size: var(--fs-14);
    user-select: none;
  }

  .faq-item summary:hover {
    color: var(--accent);
  }

  .faq-item p {
    font-size: var(--fs-14);
    line-height: 1.6;
    color: var(--ink-2);
    margin-top: var(--space-3);
    margin-bottom: 0;
  }
</style>

<script>
  // Initialize reveal script on scroll
  const revealElements = document.querySelectorAll(".reveal");

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add("is-visible");
      }
    });
  });

  revealElements.forEach((el) => observer.observe(el));
</script>
