---
interface Skill {
  text: string;
  lenses?: string[];
}

interface Props {
  title: string;
  skills: Skill[];
  activeLens?: string;
}

const { title, skills, activeLens = "" } = Astro.props;
---

<div class="skill-column">
  <h4>{title}</h4>
  <div class="skills-list">
    {skills.map((skill) => (
      <span
        class={`skill-tag ${
          activeLens && skill.lenses?.includes(activeLens) ? "highlighted" : ""
        }`}
        data-l={skill.lenses?.join(" ") || ""}
      >
        {skill.text}
      </span>
    ))}
  </div>
</div>

