---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';

interface Props {
  title: string;
  description?: string;
}

const { title, description = `${profile.primaryTitle} with ${profile.experience} building production systems, data platforms, and independent products. India-based and open to international, remote, and hybrid opportunities.` } = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://udhayakumar.com").toString();
const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Udhayakumar",
  url: "https://udhayakumar.com",
  jobTitle: profile.primaryTitle,
  description,
  address: { "@type": "PostalAddress", addressCountry: "IN" },
  sameAs: [
    profile.links.linkedin,
    profile.links.github,
  ],
};

const breadcrumbItems = [];
breadcrumbItems.push({ "@type": "ListItem", position: 1, name: "Home", item: "https://udhayakumar.com" });
if (Astro.url.pathname.startsWith("/case-studies")) {
  breadcrumbItems.push({ "@type": "ListItem", position: 2, name: "Case Studies", item: "https://udhayakumar.com/case-studies" });
}
if (Astro.url.pathname.startsWith("/resume")) {
  breadcrumbItems.push({ "@type": "ListItem", position: 2, name: "Resume", item: "https://udhayakumar.com/resume" });
}
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems,
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <script is:inline>
    (function() {
      const saved = localStorage.getItem('theme');
      const theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="author" content="Udhayakumar">
  <link rel="canonical" href={canonical}>

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-DDRCFD4HSF"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-DDRCFD4HSF');
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;800&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content="https://udhayakumar.com/og-image.svg">
  <meta property="og:image:type" content="image/svg+xml">
  <meta property="og:image:alt" content="Udhaya Kumar — Senior Backend Engineer">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content="https://udhayakumar.com/og-image.svg">
  <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)}></script>

  <style>
    main {
      max-width: 860px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .footer-nav {
      margin-top: var(--space-6);
      padding-top: var(--space-6);
      border-top: 1px solid var(--rule);
      display: flex;
      gap: var(--space-4);
      justify-content: center;
      flex-wrap: wrap;
    }

    .footer-nav a {
      font-family: "IBM Plex Mono", monospace;
      font-size: 14px;
      color: var(--accent);
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: border-color 0.2s ease;
    }

    .footer-nav a:hover {
      border-bottom-color: var(--accent);
    }

    .footer-nav a:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
  </style>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <Header currentPath={Astro.url.pathname} />

  <main id="main-content">
    <slot />
  </main>

  <Footer>
    <nav class="footer-nav">
      <a href="/engineering-notes">Incident Log & Postmortems</a>
      <a href="/architecture-decisions">Architecture Decision Records</a>
    </nav>
  </Footer>

  <button id="back-to-top" aria-label="Back to top" class="fixed bottom-6 right-6 w-12 h-12 border border-rule bg-bg text-ink cursor-pointer rounded font-[20px] hidden z-[999] transition-all ease-[0.2s]">↑</button>

  <script>
    const backToTopBtn = document.getElementById('back-to-top');

    window.addEventListener('scroll', () => {
      if (window.scrollY > 300) {
        backToTopBtn.style.display = 'block';
      } else {
        backToTopBtn.style.display = 'none';
      }
    });

    backToTopBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    backToTopBtn.addEventListener('mouseenter', () => {
      backToTopBtn.style.borderColor = 'var(--accent)';
      backToTopBtn.style.color = 'var(--accent)';
    });

    backToTopBtn.addEventListener('mouseleave', () => {
      backToTopBtn.style.borderColor = 'var(--rule)';
      backToTopBtn.style.color = 'var(--ink)';
    });
  </script>

</body>
</html>
