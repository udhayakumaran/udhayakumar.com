---
---

<div class="activity-widget reveal">
  <img
    id="ghChart"
    src="https://ghchart.rshah.org/6E7B4C/udhayakumaran"
    alt="GitHub contribution chart"
    style="max-width: 100%; height: auto;"
    loading="lazy"
    width="663"
    height="104"
  />
  <p class="activity-caption">
    <span id="gh-live">checked just now</span>
  </p>
</div>

<style>
  .activity-widget {
    padding: var(--space-6);
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: 4px;
    text-align: center;
  }

  .activity-caption {
    font-family: "IBM Plex Mono", monospace;
    font-size: var(--fs-12);
    color: var(--ink-2);
    margin-top: var(--space-4);
  }
</style>

<script>
  // Fetch live GitHub activity
  async function updateGitHubActivity() {
    try {
      const response = await fetch(
        "https://api.github.com/users/udhayakumaran/events/public",
        {
          headers: { Accept: "application/vnd.github.v3+json" },
        }
      );
      if (!response.ok) throw new Error("Failed to fetch");
      const events = await response.json();
      if (events.length > 0) {
        const lastEvent = new Date(events[0].created_at);
        const now = new Date();
        const diffMs = now - lastEvent;
        const diffMins = Math.floor(diffMs / 60000);
        const diffHours = Math.floor(diffMs / 3600000);
        const diffDays = Math.floor(diffMs / 86400000);

        let timeStr = "just now";
        if (diffMins > 0 && diffMins < 60) {
          timeStr = `${diffMins}m ago`;
        } else if (diffHours > 0 && diffHours < 24) {
          timeStr = `${diffHours}h ago`;
        } else if (diffDays > 0) {
          timeStr = `${diffDays}d ago`;
        }

        const caption = document.getElementById("gh-live");
        if (caption) {
          caption.textContent = `last activity ${timeStr}`;
        }
      }
    } catch (error) {
      // Silently fail — GitHub widget is optional
      console.debug("GitHub activity fetch failed (expected in sandboxed environments)");
    }
  }

  // Update on load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", updateGitHubActivity);
  } else {
    updateGitHubActivity();
  }
</script>
