---
interface Props {
  name: string;
  description: string;
  status: string;
  image?: string;
}

const { name, description, status, image } = Astro.props;
---

<article class="product-card reveal">
  {image && (
    <img src={image} alt={`${name} product screenshot`} class="product-image" loading="lazy" width="1280" height="800" />
  )}
  <h4>{name}</h4>
  <p>{description}</p>
  <span class="product-status">{status}</span>
</article>

<style>
  .product-card {
    padding: var(--space-6);
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .product-card:hover {
    background: var(--panel-2);
    transform: translateY(-2px);
  }

  .product-image {
    width: 100%;
    max-height: 150px;
    object-fit: cover;
    margin-bottom: var(--space-4);
    border-radius: 4px;
  }

  .product-card h4 {
    margin-bottom: var(--space-2);
  }

  .product-card p {
    font-size: var(--fs-14);
    color: var(--ink-2);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .product-status {
    display: inline-block;
    padding: var(--space-2) var(--space-3);
    background: var(--accent-wash);
    color: var(--accent-ink);
    font-family: "IBM Plex Mono", monospace;
    font-size: var(--fs-11);
    font-weight: 600;
    border-radius: 2px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
