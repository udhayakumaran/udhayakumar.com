---
interface Props {
  name: string;
  description: string;
  status: string;
  image?: string;
}

const { name, description, status, image } = Astro.props;
---

<article class="product-card reveal">
  {image && (
    <img src={image} alt={`${name} product screenshot`} class="product-image" loading="lazy" width="1280" height="800" />
  )}
  <h4>{name}</h4>
  <p>{description}</p>
  <span class="product-status">{status}</span>
</article>

