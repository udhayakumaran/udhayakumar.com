---
interface Props {
  quote: string;
  name: string;
  role: string;
}

const { quote, name, role } = Astro.props;
---

<div class="p-6 bg-panel border border-rule rounded">
  <p class="text-16 leading-[1.8] text-ink mb-4 italic">"{quote}"</p>
  <p class="text-14 text-accent font-semibold mb-1">{name}</p>
  <p class="text-14 text-ink-2">{role}</p>
</div>
