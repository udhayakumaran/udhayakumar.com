---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTAButton from '../components/CTAButton.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import StatBar from '../components/StatBar.astro';
import StatCallout from '../components/StatCallout.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import ToolLogoGrid from '../components/ToolLogoGrid.astro';
import LensSelector from '../components/LensSelector.astro';
import ActivityWidget from '../components/ActivityWidget.astro';
import ProductCard from '../components/ProductCard.astro';
import SkillsColumn from '../components/SkillsColumn.astro';
import TimelineEntry from '../components/TimelineEntry.astro';
---

<Layout title="Udhayakumar — Backend Engineer & Data Platform Architect">
  <!-- Hero / Masthead -->
  <section style="padding: var(--space-section) 0 0;">
    <h1 style="margin-bottom: var(--space-4);">
      Backend engineer who builds <span style="color: var(--sage);">and scales</span> data infrastructure
    </h1>
    <p style="font-size: var(--fs-18); color: var(--ink-2); margin-bottom: var(--space-6); max-width: 65ch;">
      Architecture through production ownership. Five years rebuilding data platforms at ConvertCart across 100+ e-commerce stores.
    </p>

    <div style="display: flex; gap: var(--space-4); flex-wrap: wrap; margin-bottom: var(--space-8); font-family: 'IBM Plex Mono', monospace; font-size: var(--fs-12); color: var(--ink-2); text-transform: uppercase; letter-spacing: 0.05em;">
      <span>13 years</span>
      <span>Bengaluru / Remote</span>
      <span>Node · TypeScript · PHP</span>
      <span>ClickHouse · MySQL · BigQuery</span>
      <span>GCP · Kubernetes</span>
    </div>

    <div style="display: flex; gap: var(--space-4); flex-wrap: wrap; margin-bottom: var(--space-section);">
      <CTAButton href="/resume" label="View résumé" variant="solid" />
      <CTAButton href="mailto:mail4udhaya@gmail.com" label="Get in touch" variant="outline" />
      <a href="https://linkedin.com/in/udhayakumar" target="_blank" rel="noopener" style="align-self: center; font-size: var(--fs-14); border-bottom: 1px solid transparent; transition: border-color 0.2s;">LinkedIn</a>
      <a href="https://github.com/udhayakumaran" target="_blank" rel="noopener" style="align-self: center; font-size: var(--fs-14); border-bottom: 1px solid transparent; transition: border-color 0.2s;">GitHub</a>
    </div>
  </section>

  <!-- Thesis -->
  <section style="padding: var(--space-section) 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule);">
    <p style="font-size: var(--fs-18); line-height: 1.8; color: var(--ink); max-width: 65ch;">
      Five years owning a data platform end to end — ingestion through serving to reporting. Rebuilt how customer and order data flows through the company: from days-late to under a minute across 100+ stores. Built segmentation and recommendation engines on top. One principle: refuse to normalize where the decision is irreversible; normalize where mistakes are reversible.
    </p>
  </section>

  <!-- Lens Selector -->
  <section style="padding: var(--space-section) 0; border-bottom: 1px solid var(--rule);">
    <LensSelector
      lenses={[
        {
          id: "data",
          label: "Data Platform",
          note: "Five years owning a data platform end to end — ingestion, modelling, serving, and the cost of running it. Two CDC paths, a warehouse consolidation, a multi-tenant landing store, and a reporting migration driven by the shape of a billing model.",
        },
        {
          id: "arch",
          label: "Architecture",
          note: "Every case study below states what I rejected and why. The through-line: refuse to normalise at the ingestion boundary where the decision is irreversible, then normalise in the warehouse where a wrong model is a redefinition rather than a migration.",
        },
        {
          id: "founding",
          label: "Founding Engineer",
          note: "Zero to one twice over — a recommendation product built from scratch inside a startup and taken to 75%+ adoption on its hardest tier, and six products designed, built and shipped alone outside one.",
        },
        {
          id: "ecom",
          label: "E-commerce",
          note: "Shopify, BigCommerce, WooCommerce, and Magento 1 and 2 — in production simultaneously for 100+ merchants. Webhook reliability, catalogue sync, storefront latency budgets, conversion attribution, and the constraint that a merchant absorbs zero cost.",
        },
      ]}
      defaultLens="data"
    />
  </section>

  <!-- By the numbers -->
  <section style="padding: var(--space-section) 0; border-bottom: 1px solid var(--rule);">
    <SectionEyebrow label="By the numbers" />
    <StatBar
      stats={[
        { value: "98%+", label: "Pipeline uptime", pct: 98 },
        { value: "100+", label: "Stores on 5 platforms", pct: 100 },
        { value: "1,000+", label: "Active segments", pct: 100 },
        { value: "75%+", label: "Smart tier adoption", pct: 75 },
      ]}
    />
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: var(--space-6); margin-top: var(--space-8);">
      <StatCallout value="<1 min" label="Data freshness" subtext="from days" />
      <StatCallout value="200ms" label="p99 latency" subtext="serving" />
      <StatCallout value="4-person" label="Team size" subtext="3-month migration" />
      <StatCallout value="₹3–7L" label="BQ cost" subtext="avg-peak/month" />
    </div>
  </section>

  <!-- Selected Work -->
  <section style="padding: var(--space-section) 0; border-bottom: 1px solid var(--rule);">
    <SectionEyebrow label="Selected work" />
    <div style="display: grid; gap: var(--space-6);">
      <CaseStudyCard
        href="/case-studies/data-platform"
        title="The data platform"
        subtitle="Rebuilt how customer and order data flows through the company — from data arriving days late to under a minute, across 100+ merchant stores on five e-commerce platforms."
        metrics={["days → <1min", "98%+ uptime", "100+ stores"]}
        variant="spotlight"
      />
      <CaseStudyCard
        href="/case-studies/segmentation"
        title="Customer segmentation"
        subtitle="Built the system that lets a non-technical Customer Success rep build audiences without writing a line of code or filing an engineering ticket. The hardest thing I built."
        metrics={["4 source systems", "1 query", "1,000+ segments"]}
        variant="spotlight"
      />
      <CaseStudyCard
        href="/case-studies/recommendations"
        title="Recommendation blocks"
        subtitle="Built the company's product recommendation feature from nothing, designed so store owners could trust it enough to turn it on. 75%+ adoption on the hardest tier."
        metrics={["75%+ adoption", "5 regions", "200ms p99"]}
        variant="spotlight"
      />
    </div>
  </section>

  <!-- Also Shipped -->
  <section style="padding: var(--space-section) 0; border-bottom: 1px solid var(--rule);">
    <SectionEyebrow label="Also shipped" />
    <div style="display: grid; gap: var(--space-6);">
      <div class="shipped-item reveal">
        <h4>Microservice fleet at ConvertCart</h4>
        <p>Recommendation ranking, email delivery, analytics ingestion, webhook distribution — split from the monolith into coordinated services. Owned deployment, configuration, and observability across the fleet. Reduced mean deployment time from 45 minutes to 8 minutes through automated CI/CD.</p>
      </div>
      <div class="shipped-item reveal">
        <h4>MySQL optimisation at Scientific Games</h4>
        <p>Lottery reporting queries running 45 minutes daily on an un-indexed 20M-row schema. Analysed and restructured queries, designed covering indexes, partitioned tables by date. Reduced the same workload from 45 minutes to 3.</p>
      </div>
      <div class="shipped-item reveal">
        <h4>Email tooling at Tenlegs</h4>
        <p>A trigger-based email system that would either send immediately or schedule for later, pulling templates from a database and applying recipient data. Handled 500K+ emails/day at peak with 99.9% delivery reliability.</p>
      </div>
    </div>
  </section>

  <!-- Activity -->
  <section style="padding: var(--space-section) 0; border-bottom: 1px solid var(--rule);">
    <SectionEyebrow label="Activity" />
    <ActivityWidget />
  </section>

  <!-- Independent Products -->
  <section style="padding: var(--space-section) 0; border-bottom: 1px solid var(--rule);">
    <SectionEyebrow label="Independent products" />
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: var(--space-6);">
      <ProductCard
        name="affairsmap.com"
        description="Current-affairs study platform for UPSC, SSC, Banking, RBI Grade B and Defence exam aspirants."
        status="In development"
      />
      <ProductCard
        name="Fruggy"
        description="Grocery shopping planner for Indian FMCG shoppers. Flutter app with a dataset of 1,500+ FMCG items."
        status="1,000+ downloads"
        image="/assets/fruggy.png"
      />
      <ProductCard
        name="HitReplAI"
        description="AI-powered social media reply generator that learns and mimics the user's writing style."
        status="Live on Chrome Web Store"
        image="/assets/hitreplai.png"
      />
      <ProductCard
        name="en-bus"
        description="Tamil Nadu bus routes and timings finder. Real-time route search across TNSTC, SETC, and MTC buses."
        status="Live · 93K+ trips"
        image="/assets/enbus.png"
      />
    </div>
  </section>

  <!-- Tech Stack -->
  <section style="padding: var(--space-section) 0; border-bottom: 1px solid var(--rule);">
    <SectionEyebrow label="Stack" />
    <ToolLogoGrid
      tools={[
        "Node.js",
        "TypeScript",
        "MySQL",
        "Debezium",
        "Pub/Sub",
        "MongoDB",
        "BigQuery",
        "ClickHouse",
        "Redis",
        "GKE",
      ]}
    />
  </section>

  <!-- Engineering Principles -->
  <section style="padding: var(--space-section) 0; border-bottom: 1px solid var(--rule);">
    <SectionEyebrow label="Principles" />
    <div style="display: grid; gap: var(--space-6);">
      <div class="principle reveal">
        <h4>Reversibility</h4>
        <p>Refuse to normalize at ingestion where the decision is irreversible. Normalize in the warehouse where a wrong model is a redefinition, not a migration.</p>
      </div>
      <div class="principle reveal">
        <h4>Match storage to question</h4>
        <p>No single database serves all workloads. Point lookups need one shape, aggregation needs another. Accept the operational cost of multiple shapes matched to their use.</p>
      </div>
      <div class="principle reveal">
        <h4>Operational simplicity</h4>
        <p>Abstractions cost clarity under pressure. Ship what's straightforward to operate and debug. Only abstract where the operational burden actually drives the design.</p>
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section style="padding: var(--space-section) 0; border-bottom: 1px solid var(--rule);">
    <SectionEyebrow label="Skills" />
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-6);">
      <SkillsColumn
        title="Deep"
        skills={[
          { text: "Data pipeline design — end-to-end ingestion, CDC, multi-layer serving", lenses: ["data", "arch"] },
          { text: "Streaming & CDC — Debezium fan-out to Pub/Sub", lenses: ["data", "arch"] },
          { text: "BigQuery & analytics — Datastream replication, materialized views", lenses: ["data"] },
          { text: "ClickHouse — schema design, partitioning, ORDER BY tuning", lenses: ["data"] },
          { text: "System design — microservices, distributed tracing, reliability", lenses: ["arch"] },
          { text: "E-commerce platforms — Shopify, BigCommerce, WooCommerce, Magento", lenses: ["ecom"] },
        ]}
      />
      <SkillsColumn
        title="Working knowledge"
        skills={[
          { text: "Kafka", lenses: ["data"] },
          { text: "Apache Beam", lenses: ["data"] },
          { text: "Kubernetes", lenses: ["arch"] },
          { text: "GCP infrastructure", lenses: ["arch"] },
          { text: "React", lenses: ["founding"] },
          { text: "React Native", lenses: ["founding"] },
          { text: "Redis", lenses: [] },
          { text: "PostgreSQL", lenses: [] },
        ]}
      />
      <SkillsColumn
        title="Leadership & Scale"
        skills={[
          { text: "Team hiring & evaluation", lenses: [] },
          { text: "Architecture ownership", lenses: [] },
          { text: "Production incident response", lenses: [] },
          { text: "Large-scale migrations", lenses: [] },
          { text: "Cross-functional partnerships", lenses: [] },
        ]}
      />
    </div>
  </section>

  <!-- Background -->
  <section style="padding: var(--space-section) 0; border-bottom: 1px solid var(--rule);">
    <SectionEyebrow label="Background" />
    <p style="font-size: var(--fs-16); line-height: 1.8; color: var(--ink); margin-bottom: var(--space-8); max-width: 65ch;">
      13 years building backend systems and data infrastructure. Started building for the web in 2010. Spent nearly six years at ConvertCart owning a data platform end to end and leading a team of engineers to rebuild it. Built segmentation and recommendation engines on top. Founded and shipped independent products. Experienced hiring and evaluating backend/data engineers; comfortable in both IC and multiplier roles.
    </p>
    <div style="display: grid; gap: 0;">
      <TimelineEntry index="A1" years="2020–2026" company="ConvertCart" role="Backend Engineer, Platform Ownership — Data ingestion, warehouse consolidation, multi-channel personalisation" />
      <TimelineEntry index="A2" years="2018–2019" company="Friday Media Group" role="Backend Engineer, Founding Team — Marketplace APIs, content ingestion, data pipeline" />
      <TimelineEntry index="A3" years="2014–2018" company="Scientific Games" role="Backend Engineer — Lottery reporting, data optimization, microservices" />
      <TimelineEntry index="A4" years="2012–2014" company="Tenlegs" role="Full-stack Engineer — Email systems, logistics APIs, operational tools" />
      <TimelineEntry index="A5" years="2010–2012" company="ISPG Technologies" role="Junior Developer — E-commerce backend, MySQL optimization" />
    </div>
  </section>

  <!-- FAQ -->
  <section style="padding: var(--space-section) 0; border-bottom: 1px solid var(--rule);">
    <SectionEyebrow label="FAQ" />
    <div style="display: grid; gap: var(--space-6);">
      <details class="faq-item">
        <summary>Notice period?</summary>
        <p>Two weeks. Flexible for the right fit.</p>
      </details>
      <details class="faq-item">
        <summary>Remote, relocation, timezone?</summary>
        <p>Remote-first. Based in Bengaluru (UTC+5:30). Open to relocation for the right role. No timezone restriction.</p>
      </details>
    </div>
  </section>
</Layout>

<style>
  .shipped-item {
    padding: var(--space-6);
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: 4px;
  }

  .shipped-item h4 {
    margin-bottom: var(--space-2);
  }

  .shipped-item p {
    font-size: var(--fs-14);
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0;
  }

  .principle {
    padding: var(--space-6);
    background: var(--sage-wash);
    border-left: 3px solid var(--sage);
    border-radius: 4px;
  }

  .principle h4 {
    margin-bottom: var(--space-2);
  }

  .principle p {
    font-size: var(--fs-14);
    line-height: 1.6;
    color: var(--ink);
    margin: 0;
  }

  .faq-item {
    padding: var(--space-4);
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: 4px;
    cursor: pointer;
  }

  .faq-item summary {
    font-family: "IBM Plex Mono", monospace;
    font-weight: 600;
    font-size: var(--fs-14);
    user-select: none;
  }

  .faq-item summary:hover {
    color: var(--accent);
  }

  .faq-item p {
    font-size: var(--fs-14);
    line-height: 1.6;
    color: var(--ink-2);
    margin-top: var(--space-3);
    margin-bottom: 0;
  }
</style>

<script>
  // Initialize reveal script on scroll
  const revealElements = document.querySelectorAll(".reveal");

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add("is-visible");
      }
    });
  });

  revealElements.forEach((el) => observer.observe(el));
</script>
