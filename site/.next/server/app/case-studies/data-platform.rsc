15:["$","div",null,{"className":"flex items-center gap-4 pt-4 border-t border-rule","children":[["$","div",null,{"className":"flex-1","children":"Pub/Sub Topic"}],["$","div",null,{"className":"text-accent","children":"→"}],["$","div",null,{"className":"px-3 py-2 bg-accent-wash border border-accent rounded text-center flex-1","children":[["$","div",null,{"className":"font-label-mono-sm text-label-mono-sm font-semibold text-accent-ink","children":"BigQuery"}],["$","div",null,{"className":"font-caption-mono text-caption-mono text-accent-ink","children":"Warehouse"}]]}],["$","div",null,{"className":"text-accent","children":"→"}],["$","div",null,{"className":"px-3 py-2 bg-panel-2 border border-rule rounded text-center flex-1","children":[["$","div",null,{"className":"font-label-mono-sm text-label-mono-sm font-semibold text-ink","children":"ClickHouse"}],["$","div",null,{"className":"font-caption-mono text-caption-mono text-ink-3","children":"Analytics"}]]}]]}]
16:["$","div",null,{"className":"pt-4 border-t border-rule text-ink-3 font-caption-mono text-caption-mono","children":"SIGNAL FLOW: SOURCES → MYSQL LANDING → DEBEZIUM CDC → PUB/SUB → WAREHOUSE & ANALYTICS"}]
17:["$","section",null,{"className":"py-12 border-b border-rule max-w-[70ch]","children":[["$","h3",null,{"className":"font-headline-md text-headline-md text-ink font-semibold mb-4","children":"My Role"}],["$","p",null,{"className":"font-body-md text-body-md text-ink-2 mb-6","children":"Owned architectural design, implementation, and operational reliability of the entire data platform. Led the technical decision-making around freshness guarantees, CDC tooling, and warehouse consolidation. Managed the execution across five parallel e-commerce platform integrations while maintaining zero data loss."}]]}]
18:["$","section",null,{"className":"py-12 border-b border-rule max-w-[70ch]","children":[["$","h3",null,{"className":"font-headline-md text-headline-md text-ink font-semibold mb-4","children":"Context"}],["$","p",null,{"className":"font-body-md text-body-md text-ink-2 mb-6","children":"Legacy data infrastructure consisted of nightly batch ETL jobs pulling data 12-24 hours behind production reality. Customer Success, Analytics, and Product teams operated on stale snapshots, making real-time decisions impossible. The data was scattered across five independent e-commerce platforms with no unified view. Migration risk was high: breaking this pipeline would halt critical business functions."}]]}]
19:["$","section",null,{"className":"py-12 border-b border-rule max-w-[70ch]","children":[["$","h3",null,{"className":"font-headline-md text-headline-md text-ink font-semibold mb-4","children":"Problem"}],["$","p",null,{"className":"font-body-md text-body-md text-ink-2 mb-6","children":"Define freshness tiers for different data classes (customer profiles update ~hourly, order events near real-time, archived data nightly) without building five separate pipelines. Enable non-engineers to query the unified dataset without SQL expertise. Handle the technical debt of migrating five independent databases while maintaining availability."}]]}]
1a:["$","section",null,{"className":"py-12 border-b border-rule max-w-[70ch]","children":[["$","h3",null,{"className":"font-headline-md text-headline-md text-ink font-semibold mb-4","children":"Architecture"}],["$","p",null,{"className":"font-body-md text-body-md text-ink-2 mb-6","children":"Chose Debezium for CDC to avoid application code changes. Deployed a single MySQL landing zone as a synchronization point, eliminating the need to maintain five separate CDC connectors. Events flowed through Google Cloud Pub/Sub for decoupling, then into BigQuery for historical analytics and ClickHouse for real-time queries. The tier-1 (sub-5-minute) data came from high-frequency webhooks; tier-2 (hourly) from database snapshots; tier-3 (nightly) from legacy batch exports. This allowed each consumer to pick the freshness they needed without forcing everyone to the most expensive option."}]]}]
1b:["$","section",null,{"className":"py-12 border-b border-rule max-w-[70ch]","children":[["$","h3",null,{"className":"font-headline-md text-headline-md text-ink font-semibold mb-4","children":"ClickHouse Tuning"}],["$","p",null,{"className":"font-body-md text-body-md text-ink-2 mb-6","children":"ClickHouse ingestion initially bottlenecked at 500 events/sec before exhibiting merge lock contention. Tuning background_pool_size and merge_tree settings revealed that InsertionTime ordering (rather than primary key ordering) reduced write amplification by 60%. Added ReplacingMergeTree to handle late-arriving updates without full re-merges, bringing sustainable throughput to 8k events/sec with p99 query latency staying under 200ms."}]]}]
1c:["$","section",null,{"className":"py-12 border-b border-rule max-w-[70ch]","children":[["$","h3",null,{"className":"font-headline-md text-headline-md text-ink font-semibold mb-4","children":"Key Decisions"}],["$","ul",null,{"className":"space-y-4 list-none","children":[["$","li",null,{"id":"decision-0","className":"p-4 bg-panel border border-rule rounded scroll-my-16","children":[["$","h4",null,{"className":"font-headline-sm text-headline-sm text-ink font-semibold mb-2","children":"MySQL as Landing Zone"}],["$","p",null,{"className":"font-body-sm text-body-sm text-ink-2","children":"Instead of managing five separate Debezium → Kafka connectors, centralize snapshot and streaming logic in one MySQL instance. Simplifies Kafka schema evolution and gives us one place to tune CDC lag and snapshot concurrency."}]]}],["$","li",null,{"id":"decision-1","className":"p-4 bg-panel border border-rule rounded scroll-my-16","children":[["$","h4",null,{"className":"font-headline-sm text-headline-sm text-ink font-semibold mb-2","children":"Tiered Freshness Model"}],["$","p",null,{"className":"font-body-sm text-body-sm text-ink-2","children":"Webhooks → Pub/Sub (tier-1, <5m), Database snapshots → Debezium (tier-2, 1h), Batch exports (tier-3, nightly). Allows customers to optimize cost/latency tradeoff without forcing all data to the highest SLA."}]]}],["$","li",null,{"id":"decision-3","className":"p-4 bg-panel border border-rule rounded scroll-my-16","children":[["$","h4",null,{"className":"font-headline-sm text-headline-sm text-ink font-semibold mb-2","children":"BigQuery + ClickHouse Dual Path"}],["$","p",null,{"className":"font-body-sm text-body-sm text-ink-2","children":"BigQuery handles slow analytics queries (minutes acceptable). ClickHouse serves fast dashboards and alerts (sub-second SLA). Confluent Kafka Connect connectors manage the writes to both. Allows independent scaling and allows engineers to tune for different workloads."}]]}]]}]]}]
1d:["$","section",null,{"className":"py-12 border-b border-rule max-w-[70ch]","children":[["$","h3",null,{"className":"font-headline-md text-headline-md text-ink font-semibold mb-4","children":"Execution"}],["$","p",null,{"className":"font-body-md text-body-md text-ink-2 mb-6","children":"Rolled out platform one merchant at a time, running dual-write (old batch + new CDC) for 2-week validation windows. Used feature flags to toggle between old and new queries. Incident response rehearsals for common failure modes: Debezium snapshot hangs, Kafka partition rebalances, ClickHouse merge storms. Built automated canary logic to detect data drift between old and new pipelines."}]]}]
1e:["$","section",null,{"className":"py-12 border-b border-rule max-w-[70ch]","children":[["$","h3",null,{"className":"font-headline-md text-headline-md text-ink font-semibold mb-4","children":"Impact"}],["$","p",null,{"className":"font-body-md text-body-md text-ink-2 mb-6","children":"Reduced data latency from 12-24 hours to 5 minutes for 80% of queries. ClickHouse replaced three separate single-purpose data warehouses, cutting infrastructure costs by 40%. Customer Success adoption jumped from 6% to 91% (measured by weekly active users) because they now had access to fresh data that matched reality. Analytics team reduced report refresh time from 4 hours to 5 minutes, enabling new real-time alerting on key business metrics."}]]}]
1f:["$","section",null,{"className":"py-12 max-w-[70ch]","children":[["$","h3",null,{"className":"font-headline-md text-headline-md text-ink font-semibold mb-4","children":"What I'd Change Today"}],["$","p",null,{"className":"font-body-md text-body-md text-ink-2 mb-6","children":"Given current tooling maturity: would use Postgres logical replication + Kafka Connect over Debezium for simpler operational debugging. ClickHouse snapshot reads had occasional consistency issues that required careful work-around logic — in retrospect, Kafka streams materialized views might have been cleaner for the sub-second use case. The dual-path (BigQuery + ClickHouse) added operational overhead that we could have replaced with a single unified warehouse had we bet on modern MPP engines earlier."}]]}]
