---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Udhayakumar — Backend Engineer & Data Platform Architect">
  <section style="padding: 52px 0; border-bottom: 1px solid var(--rule);">
    <h1 style="font-family: 'JetBrains Mono', monospace; font-size: 40px; font-weight: 600; margin-bottom: 12px;">Udhayakumar</h1>
    <p style="font-size: 18px; color: var(--ink-2); margin-bottom: 16px; max-width: 600px;">Backend engineer who builds and scales data infrastructure at growth-stage startups — architecture through production ownership.</p>
    <p style="font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--ink-3); letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 8px;">Backend Engineer — Data Platforms & Architecture</p>
    <div style="display: flex; gap: 32px; flex-wrap: wrap; margin-bottom: 24px; font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--ink-2);">
      <span>13 yrs</span>
      <span>Bengaluru / Remote</span>
      <span>Node, TypeScript, PHP</span>
      <span>ClickHouse, MySQL, BigQuery</span>
      <span>GCP, Kubernetes</span>
    </div>
    <div style="display: flex; gap: 20px; flex-wrap: wrap;">
      <a href="#" style="text-decoration: none; color: var(--ink); font-family: 'JetBrains Mono', monospace; font-size: 14px; font-weight: 500; border-bottom: 1px solid transparent; transition: border-color 0.2s ease;">Résumé</a>
      <a href="mailto:mail4udhaya@gmail.com" style="text-decoration: none; color: var(--ink); font-family: 'JetBrains Mono', monospace; font-size: 14px; font-weight: 500; border-bottom: 1px solid transparent; transition: border-color 0.2s ease;">Email</a>
      <a href="https://linkedin.com/in/udhayakumar" target="_blank" rel="noopener" style="text-decoration: none; color: var(--ink); font-family: 'JetBrains Mono', monospace; font-size: 14px; font-weight: 500; border-bottom: 1px solid transparent; transition: border-color 0.2s ease;">LinkedIn</a>
      <a href="https://github.com/udhayakumaran" target="_blank" rel="noopener" style="text-decoration: none; color: var(--ink); font-family: 'JetBrains Mono', monospace; font-size: 14px; font-weight: 500; border-bottom: 1px solid transparent; transition: border-color 0.2s ease;">GitHub</a>
    </div>
  </section>

  <section style="padding: 52px 0;">
    <h2 style="font-family: 'JetBrains Mono', monospace; font-size: 20px; font-weight: 600; margin-bottom: 20px;">Selected Work</h2>
    <p style="font-size: 16px; color: var(--ink-2); margin-bottom: 24px;">Featured case studies coming soon.</p>
  </section>
</Layout>

<style>
  a:hover {
    border-bottom-color: var(--accent);
  }
  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
