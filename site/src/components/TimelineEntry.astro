---
interface Props {
  index: string;
  years: string;
  company: string;
  role: string;
}

const { index, years, company, role } = Astro.props;
---

<div class="timeline-entry reveal">
  <div class="entry-index">{index}</div>
  <div class="entry-content">
    <div class="entry-years">{years}</div>
    <h4>{company}</h4>
    <p>{role}</p>
  </div>
</div>

