---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { profile } from '../data/profile';

interface Props {
  title: string;
  description?: string;
}

const { title, description = `${profile.primaryTitle} with ${profile.experience} building production systems, data platforms, and independent products. India-based and open to international, remote, and hybrid opportunities.` } = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://udhayakumar.com").toString();
const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Udhayakumar",
  url: "https://udhayakumar.com",
  jobTitle: profile.primaryTitle,
  description,
  address: { "@type": "PostalAddress", addressCountry: "IN" },
  sameAs: [
    profile.links.linkedin,
    profile.links.github,
  ],
};

const breadcrumbItems = [];
breadcrumbItems.push({ "@type": "ListItem", position: 1, name: "Home", item: "https://udhayakumar.com" });
if (Astro.url.pathname.startsWith("/case-studies")) {
  breadcrumbItems.push({ "@type": "ListItem", position: 2, name: "Case Studies", item: "https://udhayakumar.com/case-studies" });
}
if (Astro.url.pathname.startsWith("/resume")) {
  breadcrumbItems.push({ "@type": "ListItem", position: 2, name: "Resume", item: "https://udhayakumar.com/resume" });
}
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems,
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <script is:inline>
    (function() {
      const saved = localStorage.getItem('theme');
      const theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="author" content="Udhayakumar">
  <link rel="canonical" href={canonical}>

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-DDRCFD4HSF"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-DDRCFD4HSF');
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;800&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content="https://udhayakumar.com/og-image.svg">
  <meta property="og:image:type" content="image/svg+xml">
  <meta property="og:image:alt" content="Udhaya Kumar — Senior Backend Engineer">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content="https://udhayakumar.com/og-image.svg">
  <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)}></script>

  <style>
    main {
      max-width: 860px;
      margin: 0 auto;
      padding: 0 20px;
    }

    /* Header */
    header {
      border-bottom: 1px solid var(--rule);
      padding: 24px 0;
      position: sticky;
      top: 0;
      background: var(--bg);
      z-index: 100;
    }

    nav {
      max-width: 860px;
      margin: 0 auto;
      padding: 0 20px;
      display: flex;
      gap: 32px;
      align-items: center;
    }

    nav a {
      text-decoration: none;
      color: var(--ink);
      font-family: "IBM Plex Mono", monospace;
      font-size: 14px;
      font-weight: 500;
      border-bottom: 2px solid transparent;
      transition: border-color 0.2s ease;
    }

    nav a:hover,
    nav a[aria-current="page"] {
      border-bottom-color: var(--accent);
    }

    nav a:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    .theme-toggle {
      background: transparent;
      border: 1px solid var(--rule-2);
      color: var(--ink);
      font-size: 14px;
      font-weight: 500;
      padding: 8px 12px;
      border-radius: 4px;
      cursor: pointer;
      transition: all 0.2s ease;
      font-family: "IBM Plex Mono", monospace;
      margin-left: auto;
    }

    .theme-toggle:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    .theme-toggle:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    /* Footer */
    footer {
      border-top: 1px solid var(--rule);
      padding: 60px 0;
      text-align: center;
      margin-top: 80px;
    }

    footer a {
      font-family: "IBM Plex Mono", monospace;
      font-size: 16px;
      font-weight: 600;
      color: var(--accent);
      text-decoration: none;
      border-bottom: 2px solid transparent;
      transition: border-color 0.2s ease;
      display: inline-block;
      margin: 8px 0;
    }

    footer a:hover,
    footer a:focus {
      border-bottom-color: var(--accent);
    }

    footer a:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 4px;
    }

    footer p {
      font-size: 14px;
      color: var(--ink-2);
      margin-bottom: 16px;
    }

    @media (max-width: 640px) {
      nav {
        gap: 16px;
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <Header currentPath={Astro.url.pathname} />

  <main id="main-content">
    <slot />
  </main>

  <footer>
    <p>Open to senior backend, platform, data infrastructure, and technical leadership roles.</p>
    <a href={`mailto:${profile.email}`}>{profile.email}</a>
    <nav style="margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--rule); display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
      <a href="/engineering-notes" style="font-family: 'IBM Plex Mono', monospace; font-size: 14px; color: var(--accent); text-decoration: none; border-bottom: 1px solid transparent; transition: border-color 0.2s ease;">Incident Log & Postmortems</a>
      <a href="/architecture-decisions" style="font-family: 'IBM Plex Mono', monospace; font-size: 14px; color: var(--accent); text-decoration: none; border-bottom: 1px solid transparent; transition: border-color 0.2s ease;">Architecture Decision Records</a>
    </nav>
  </footer>

  <button id="back-to-top" aria-label="Back to top" style="position: fixed; bottom: 24px; right: 24px; width: 48px; height: 48px; border: 1px solid var(--rule); background: var(--bg); color: var(--ink); cursor: pointer; border-radius: 4px; font-size: 20px; display: none; z-index: 999; transition: all 0.2s ease;">↑</button>

  <script>
    const backToTopBtn = document.getElementById('back-to-top');

    window.addEventListener('scroll', () => {
      if (window.scrollY > 300) {
        backToTopBtn.style.display = 'block';
      } else {
        backToTopBtn.style.display = 'none';
      }
    });

    backToTopBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    backToTopBtn.addEventListener('mouseenter', () => {
      backToTopBtn.style.borderColor = 'var(--accent)';
      backToTopBtn.style.color = 'var(--accent)';
    });

    backToTopBtn.addEventListener('mouseleave', () => {
      backToTopBtn.style.borderColor = 'var(--rule)';
      backToTopBtn.style.color = 'var(--ink)';
    });
  </script>

</body>
</html>
