---
import Layout from '../layouts/Layout.astro';
import CTAButton from '../components/CTAButton.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { profile } from '../data/profile';
---

<Layout title="Udhaya Kumar — Senior Backend Engineer" description="Senior Backend Engineer with 13+ years building reliable backend systems and data infrastructure for data-intensive products. India-based and open to international, remote, and hybrid opportunities.">
  <section class="hero">
    <p class="eyebrow">Hiring profile</p>
    <h1>{profile.primaryTitle}</h1>
    <p class="hero-lede">I build reliable backend and data systems where architecture, migration, production operation, and recovery all matter.</p>
    <p class="hero-meta">{profile.experience} · {profile.convertCart.platformOwnership} owning production data infrastructure · India-based · remote worldwide</p>
    <div class="hero-actions"><CTAButton href="#selected-work" label="View my work" variant="solid" /><CTAButton href="/resume" label="Resume" variant="outline" /><CTAButton href={`mailto:${profile.email}`} label="Email me" variant="outline" /></div>
    <p class="hero-links"><a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a><a href={profile.links.github} target="_blank" rel="noopener noreferrer">GitHub</a></p>
  </section>

  <section class="hiring-thesis"><SectionEyebrow label="Hiring thesis" /><p class="thesis-copy">I work best on ambiguous backend problems that need architecture ownership, safe migrations, production responsibility, and measurable product outcomes.</p><p class="role-fit"><strong>Relevant role fit:</strong> {profile.roleFit.join(' · ')}</p></section>

  <section class="production-proof"><SectionEyebrow label="Production proof" /><div class="proof-list">
    <article><p class="proof-kicker">Ownership · system · scale</p><h2>Data platform</h2><p>I owned the rebuild of customer and order data infrastructure serving {profile.proof.merchants} across five commerce platforms. Webhook freshness moved from days-late batch data to sub-minute.</p><strong>Days → sub-minute webhook freshness</strong></article>
    <article><p class="proof-kicker">Ownership · product · adoption</p><h2>Recommendation system</h2><p>I initiated and built a three-tier recommendation product, from trust-first manual blocks to live ranking across five regions.</p><strong>{profile.proof.recommendations}</strong></article>
    <article><p class="proof-kicker">Ownership · data product · rollout</p><h2>Customer segmentation</h2><p>I owned the query model and builder that unified four source systems for Customer Success teams.</p><strong>{profile.proof.segmentation}</strong></article>
  </div></section>

  <section id="selected-work" class="selected-work"><SectionEyebrow label="Selected work · recommended reading order" /><p class="section-intro">Start with the data platform, then read the production incident. These show architecture ownership and operational judgment fastest.</p><div class="case-list">
    <div class="case-entry recommended"><p class="case-label">Primary case study · recommended first read</p><CaseStudyCard href="/case-studies/data-platform" title="The data platform" subtitle="I owned architecture, migration, and rollout for customer and order data across 200+ merchants on five commerce platforms. Freshness moved from days-late batch data to sub-minute webhook freshness." metrics={["days → sub-minute", "3-month migration", "200+ merchants"]} variant="spotlight" /></div>
    <div class="case-entry"><p class="case-label">Product system · recommendations</p><CaseStudyCard href="/case-studies/recommendations" title="Recommendation blocks" subtitle="I owned the trust ladder, serving system, and adoption measurement for a recommendation product built from zero." metrics={["80%+ trial adoption", "5 regions", "200ms p99"]} variant="spotlight" /></div>
    <div class="case-entry"><p class="case-label">Customer data product · self-serve</p><CaseStudyCard href="/case-studies/segmentation" title="Customer segmentation" subtitle="I owned the query model, builder, and production operation that turned four source systems into self-serve audience creation." metrics={["4 source systems", "1,000+ active segments", "minutes not days"]} variant="spotlight" /></div>
  </div></section>

  <section class="incident-feature"><div><p class="item-kicker">Production incident · technical deep dive</p><h2>I stopped a production migration when a 50M-row CDC snapshot began blocking writes.</h2><p>Debezium consumed 60% CPU. I stopped the snapshot, used the existing Datastream path to recover, and changed the rollout strategy.</p></div><a href="/engineering-notes/debezium-50m-row-snapshot/">Read the incident and recovery decisions →</a></section>

  <section class="independent-work"><SectionEyebrow label="Independent products" /><p class="section-intro">Supporting evidence of founding-engineer range: product decisions, backend, UX, AI integration, and deployment.</p><div class="independent-list">
    <article><p class="item-kicker">AI product · live build</p><h2>BriefMyDoctor</h2><p>Controlled-content and LLM-assisted product that helps people prepare for doctor visits.</p></article>
    <article><p class="item-kicker">Chrome extension · shipped</p><h2>HitReplAI</h2><p>Built browser interaction, backend persistence, AI integration, marketing site, and deployment path.</p></article>
    <article><p class="item-kicker">Public data product · live</p><h2>enbus</h2><p>Tamil Nadu bus route search powered by PostgreSQL, fuzzy/full-text search, and an indexed route model.</p></article>
  </div></section>

  <section class="final-cta"><SectionEyebrow label="Next step" /><h2>Hiring for a senior backend engineer who can own a difficult system end to end?</h2><p>Start with the general resume, then email me with the system you need owned.</p><div class="hero-actions"><CTAButton href="/resume" label="View Resume" variant="solid" /><CTAButton href={`mailto:${profile.email}`} label="Email Udhaya" variant="outline" /></div></section>
</Layout>

<style>
  .hero { padding: var(--space-section) 0 var(--space-10); }
  .hero h1 { max-width: 12ch; margin-bottom: var(--space-4); }
  .hero-lede { max-width: 58ch; font-size: clamp(20px, 3vw, 28px); line-height: 1.35; margin-bottom: var(--space-4); }
  .hero-meta, .role-fit { color: var(--ink-2); max-width: 70ch; }
  .hero-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-6); }
  .hero-links { display: flex; gap: var(--space-4); margin-top: var(--space-4); font-size: var(--fs-14); }
  .hiring-thesis, .production-proof, .selected-work, .incident-feature, .independent-work, .final-cta { border-top: 1px solid var(--rule); padding: var(--space-section) 0; }
  .thesis-copy { max-width: 64ch; font-size: var(--fs-24); line-height: 1.45; margin-bottom: var(--space-4); }
  .proof-list, .independent-list { display: grid; gap: var(--space-6); }
  .proof-list article { padding: var(--space-6) 0; border-bottom: 1px solid var(--rule); max-width: 70ch; }
  .proof-list h2 { font-size: var(--fs-20); margin-bottom: var(--space-2); }
  .proof-list p { max-width: 65ch; color: var(--ink-2); }
  .proof-list strong { display: block; margin-top: var(--space-3); color: var(--accent); font-family: "IBM Plex Mono", monospace; font-size: var(--fs-13); }
  .proof-kicker, .case-label, .item-kicker { color: var(--accent); font-family: "IBM Plex Mono", monospace; font-size: var(--fs-12); text-transform: uppercase; letter-spacing: .08em; margin-bottom: var(--space-2); }
  .section-intro { max-width: 65ch; color: var(--ink-2); margin-bottom: var(--space-6); }
  .case-list { display: grid; gap: var(--space-6); }
  .case-label { margin-bottom: var(--space-2); }
  .case-entry.recommended { border: 1px solid var(--accent); padding: var(--space-4); }
  .case-entry.recommended .case-label { font-weight: 600; }
  .incident-feature { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-8); align-items: end; }
  .incident-feature h2 { max-width: 26ch; font-size: clamp(24px, 4vw, 36px); }
  .incident-feature p:not(.item-kicker) { max-width: 65ch; color: var(--ink-2); }
  .independent-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .independent-list article { padding-top: var(--space-4); border-top: 1px solid var(--rule); }
  .independent-list h2 { font-size: var(--fs-20); margin-bottom: var(--space-2); }
  .independent-list p:not(.item-kicker), .final-cta p { color: var(--ink-2); }
  .final-cta { border-bottom: 1px solid var(--rule); }
  .final-cta h2 { max-width: 32ch; }
  @media (max-width: 640px) { .hero h1 { max-width: none; } .incident-feature, .independent-list { grid-template-columns: 1fr; } }
</style>
