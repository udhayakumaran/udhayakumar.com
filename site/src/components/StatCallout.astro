---
interface Props {
  value: string;
  label: string;
  subtext?: string;
}

const { value, label, subtext } = Astro.props;
---

<div class="stat-callout reveal">
  <div class="stat-value">{value}</div>
  <div class="stat-label">{label}</div>
  {subtext && <div class="stat-subtext">{subtext}</div>}
</div>

