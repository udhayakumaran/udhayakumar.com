---
interface Props {
  href: string;
  title: string;
  subtitle: string;
  metrics?: string[];
  variant?: "compact" | "spotlight";
  isMostRelevant?: boolean;
}

const {
  href,
  title,
  subtitle,
  metrics = [],
  variant = "compact",
  isMostRelevant = false,
} = Astro.props;
---

{
  variant === "spotlight" ? (
    <a href={href} class="case-study-spotlight">
      <div class="spotlight-content">
        <h3>{title}</h3>
        <p>{subtitle}</p>
        {metrics.length > 0 && (
          <div class="metrics">
            {metrics.map((metric) => (
              <span class="metric-chip">{metric}</span>
            ))}
          </div>
        )}
      </div>
    </a>
  ) : (
    <a href={href} class="case-study-card">
      <div class="card-header">
        <h4>{title}</h4>
        {isMostRelevant && <span class="most-relevant">most relevant</span>}
      </div>
      <p class="card-subtitle">{subtitle}</p>
      {metrics.length > 0 && (
        <div class="metrics">
          {metrics.map((metric) => (
            <span class="metric-chip">{metric}</span>
          ))}
        </div>
      )}
    </a>
  )
}

